{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["significant", "significance", "summary", "rationale", "uncertainty_note"],
  "properties": {
    "significant": {"type": "boolean"},
    "significance": {"type": "integer", "minimum": 0, "maximum": 100},
    "summary": {"type": "string", "minLength": 1, "maxLength": 160},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 320},
    "uncertainty_note": {
      "anyOf": [{"type": "string", "maxLength": 200}, {"type": "null"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"significant": {"const": false}}, "required": ["significant"]},
      "then": {"properties": {"significance": {"maximum": 69}}}
    }
  ]
}
